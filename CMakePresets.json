{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "JFCDISPATCH_BUILD_TESTS": "ON",
        "JFCDISPATCH_BUILD_DOCS": "OFF",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux / gcc",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux / clang",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "linux-gcc-ci",
      "displayName": "Linux / gcc / warnings are errors",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror"
      }
    },
    {
      "name": "linux-clang-ci",
      "displayName": "Linux / clang / warnings are errors",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror"
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "displayName": "Linux / clang / address + undefined sanitizers",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-clang-tsan",
      "displayName": "Linux / clang / thread sanitizer",
      "description": "the threaded tests under ThreadSanitizer: what a dispatcher does across threads, checked",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "linux-docs",
      "displayName": "Linux / documentation",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "JFCDISPATCH_BUILD_TESTS": "OFF",
        "JFCDISPATCH_BUILD_DOCS": "ON"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS / clang",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "description": "std::filesystem needs macOS 10.15.",
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows / MSVC",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /EHsc /permissive- /utf-8"
      }
    },
    {
      "name": "windows-msvc-ci",
      "displayName": "Windows / MSVC / warnings are errors",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /WX /EHsc /permissive- /utf-8"
      }
    },
    {
      "name": "windows-msvc-cross",
      "displayName": "Windows / MSVC / cross from unix (msvc-wine)",
      "description": "Cross-compiles the windows leg through msvc-wine; ctest runs the tests under wine. Set MSVC_WINE_ROOT if msvc-wine is not in /opt/msvc.",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/jfc-cmake/toolchains/toolchain-msvc-wine.cmake",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /EHsc /permissive- /utf-8"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    },
    {
      "name": "linux-gcc-ci",
      "configurePreset": "linux-gcc-ci"
    },
    {
      "name": "linux-clang-ci",
      "configurePreset": "linux-clang-ci"
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan"
    },
    {
      "name": "linux-clang-tsan",
      "configurePreset": "linux-clang-tsan"
    },
    {
      "name": "linux-docs",
      "configurePreset": "linux-docs"
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-ci",
      "configurePreset": "windows-msvc-ci",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-cross",
      "configurePreset": "windows-msvc-cross"
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-ci",
      "configurePreset": "linux-gcc-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-ci",
      "configurePreset": "linux-clang-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-tsan",
      "configurePreset": "linux-clang-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-ci",
      "configurePreset": "windows-msvc-ci",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-cross",
      "configurePreset": "windows-msvc-cross",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
